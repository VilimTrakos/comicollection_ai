# Copy to /etc/comicollect/production.env as root:comicollect mode 0640.
# Never place the pepper itself in this file or in source control.
COMICOLLECT_DATA_ROOT=/var/lib/comicollect
COMICOLLECT_PASSWORD_PEPPER_FILE=/etc/comicollect/password-pepper
COMICOLLECT_PUBLIC_REGISTRATION=false
COMICOLLECT_PORT=8787
COMICOLLECT_TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1
COMICOLLECT_GUNICORN_THREADS=4
COMICOLLECT_REQUEST_TIMEOUT_SECONDS=30
COMICOLLECT_ACCESS_TTL_SECONDS=900
COMICOLLECT_REFRESH_TTL_SECONDS=2592000
COMICOLLECT_SESSION_TTL_SECONDS=7776000
COMICOLLECT_TENANT_STORAGE_LIMIT_BYTES=536870912
COMICOLLECT_DISK_RESERVE_BYTES=1073741824
COMICOLLECT_BACKUP_RESERVE_BYTES=1073741824
LOG_LEVEL=INFO
