[Unit]
Description=Comicollect local sync server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=comicollect
Group=comicollect
EnvironmentFile=/etc/comicollect.env
ExecStart=/usr/bin/python3 /opt/comicollect/comicollect_server.py --mode legacy
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/comicollect /var/backups/comicollect

[Install]
WantedBy=multi-user.target
